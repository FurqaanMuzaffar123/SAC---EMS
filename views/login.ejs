<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/css/login.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SAC - Authenticate</title>
  </head>

  <body>
    <div class="login-layout">
      <section class="branding">
        <div class="bg-square"></div>
        <h1 class="brand-heading">SAC · EMS</h1>
        <p class="full-form">ST. AGNES COLLEGE - ELECTION MANAGEMENT SYSTEM</p>
      </section>
      
      <div class="divider"></div>
      <section class="auth-panel">
        <h1 class="auth-heading">Authenticate</h1>
        <form action="/login" method="POST">
          <div class="field">
            <label for="register">Register Number</label>
            <input 
              type="text" 
              name="register" 
              id="register"
              inputmode="numeric"
              maxlength="8"
              autocomplete="off"
              spellcheck="false"
              placeholder="eg. 24012328"
            >
          </div>
          <div class="field">
            <label for="phone">Phone Number</label>
            <input 
              type="tel" 
              name="phone" 
              id="phone"
              inputmode="numeric"
              maxlength="10"
              autocomplete="tel"
              placeholder="eg. 9876543210"
              pattern="[6-9][0-9]{9}"
            >
          </div>
          <button type="submit" class="submit-btn">LOGIN</button>
        </form>
      </section>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/js/login.js"></script>
  </body>
</html>
